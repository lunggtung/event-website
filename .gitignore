# ==========================================
# .gitignore chuan cho Du an WordPress Nhom 2
# Mon hoc: Ma nguon mo
# ==========================================

# 1. Bo qua WordPress Core (Khong commit ma nguon goc cua WordPress)
wp-admin/
wp-includes/
/*.php
!wp-config-sample.php

# Giu lai thu muc wp-content nhung loai tru cac thanh phan khong can thiet
wp-content/*
!wp-content/themes/
!wp-content/themes/event-child/
!wp-content/themes/event-child/**

# 2. Bo qua file cau hinh nhay cam va thong tin may chu
wp-config.php
.htaccess
*.log
*.sql.gz
*.bak

# 3. Bo qua thu muc upload du lieu da phong (anh, video tai len tu admin)
wp-content/uploads/

# 4. Bo qua cac plugin cai them (cac plugin duoc liet ke trong LICENSES.md)
wp-content/plugins/
wp-content/mu-plugins/

# 5. Bo qua cac theme mac dinh hoac theme cha (Astra tai tu trang WordPress)
wp-content/themes/twenty*/
wp-content/themes/astra/

# 6. Bo qua cache & file tam
wp-content/cache/
wp-content/uploads/
node_modules/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
output/

# 6b. Bo qua anh chup man hinh va ket qua kiem thuc sinh ra khi phat trien
test-*.png
*.local.png

# 7. Cho phep theo doi cac thu muc quan trong noi bai
!database/
!database/**
!specs/
!specs/**
!README.md
!LICENSES.md

# 8. Bo qua tai lieu lam viec noi bo (Khong dua len GitHub)
docs/
*.tmp
*.docx
*credentials*
*.secret*
*.local*
.env*
*.pptx
*.pdf
